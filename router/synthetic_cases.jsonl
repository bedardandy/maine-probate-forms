{"case": {"case_id": "2025-CP-04821", "case_type": "estate_intestate", "jurisdiction": {"state": "ME", "county": "Cumberland", "town": "South Portland", "court": "Maine District Court Probate Division"}, "parties": {"decedent": {"full_name": "Eleanor V. Thibodeau", "address": "142 Pine Street, South Portland, ME 04106", "phone": "(207) 555-0198", "dob": "1952-03-14"}, "applicant": {"full_name": "Michael J. Thibodeau", "address": "142 Pine Street, South Portland, ME 04106", "phone": "(207) 555-0199", "attrs": {"role": "Surviving Spouse"}}, "personal_representative": {"full_name": "Michael J. Thibodeau", "address": "142 Pine Street, South Portland, ME 04106", "phone": "(207) 555-0199"}, "claimant": {"full_name": "Blackwood Construction LLC", "address": "88 Commerce Way, Portland, ME 04101", "phone": "(207) 555-0245", "attrs": {"contact": "David R. Kowalski"}}, "attorney": {"full_name": "Sarah L. Brennan", "address": "150 Congress Street, Portland, ME 04101", "phone": "(207) 555-0301", "attrs": {"firm": "Brennan & Associates LLP", "bar_number": "ME-8238"}, "email": "sarah.brennan@mainelaw.com"}}, "facts": {"creditor_claim_filed": true, "claim_disallowed": true, "testacy": "intestate", "spouse_surviving": true, "has_minor_heirs": false, "real_estate_in_estate": true, "claim_amount": 14500.0, "disallowance_reason": "Insufficient documentation and disputed valuation"}, "description": "Intestate estate of Eleanor V. Thibodeau. Surviving spouse Michael J. Thibodeau appointed as PR. Creditor Blackwood Construction LLC filed a claim for unpaid contractor services. PR disallowed the claim citing lack of proper notice and disputed valuation. Claimant petitions the court to resolve the disputed claim.", "party_lists": {}, "extra_parties": {}}, "event": {"case_id": "2025-CP-04821", "type": "decedent_death_date", "date": "2025-01-22", "metadata": {"claim_filing_date": "2025-04-10", "disallowance_notice_date": "2025-05-22", "petition_type": "Petition to Resolve Disputed Claim", "he