{"case": {"case_id": "2025-EP-00403-ME", "case_type": "estate_intestate", "jurisdiction": "Maine Probate Court, Androscoggin County", "parties": {"decedent": {"full_name": "Arthur W. Thibodeau", "dod": "2025-02-18", "address": "14 Birchwood Lane, Gray, ME 04039"}, "spouse": {"full_name": "Eleanor M. Thibodeau", "address": "14 Birchwood Lane, Gray, ME 04039", "phone": "207-555-0142"}, "applicant": {"full_name": "Marcus J. Thibodeau", "address": "221 State Street, Portland, ME 04101", "phone": "207-555-0198"}, "personal_representative": {"full_name": "Marcus J. Thibodeau", "address": "221 State Street, Portland, ME 04101", "phone": "207-555-0198"}, "attorney": {"full_name": "Sarah L. Vance", "address": "15 Maple Street, Auburn, ME 04210", "phone": "207-555-0221", "attrs": {"firm": "Vance & Associates, P.A.", "bar_number": "ME-17883"}, "email": "sarah.vance@portlandlaw.com"}}, "facts": {"renunciation_filed": true, "testacy": "intestate", "spouse_surviving": true, "real_estate_in_estate": true, "has_minor_heirs": false}, "narrative": "Arthur W. Thibodeau died intestate on 2025-02-18, survived by his wife Eleanor and their adult son Marcus. Eleanor holds statutory priority for appointment as personal representative but has formally filed a renunciation of her priority right in favor of Marcus. Marcus petitions the court for appointment as PR to administer the estate, which includes a primary residence in Gray and several investment accounts. No minor heirs are involved, and the renunciation allows Marcus to assume full fiduciary duties without court-supervised spousal administration.", "party_lists": {}, "extra_parties": {}}, "event": {"type": "decedent_death_date", "case_id": "2025-EP-00403-ME", "date": "2025-02-18", "description": "Decedent Arthur W. Thibodeau passed away at his residence in Gray, ME, initiating the intestate probate proceeding.", "source_document": "Maine Death Certificate #2025-048291"}, "id": "estate_intestate_maine_403", "description": "Synthesized