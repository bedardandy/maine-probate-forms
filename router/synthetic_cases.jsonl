{"case": {"case_id": "2024-CB-00916-CON", "case_type": "conservatorship", "parties": {"conservator": {"full_name": "Eleanor Vance", "address": "412 Congress Street, Portland, ME 04101", "phone": "207-555-0142"}, "individual_under_protection": {"full_name": "Thomas J. Ellison", "address": "78 Pine Ridge Road, South Portland, ME 04106", "phone": "207-555-0198"}, "attorney": {"full_name": "David P. Whitmore", "address": "150 Main Street, Auburn, ME 04210", "phone": "207-555-0287", "attrs": {"firm": "Whitmore & Associates", "bar_number": "ME-5277"}, "email": "david.whitmore@whitmore.com"}}, "facts": {"is_initial_petition": true, "filing_type": "petition", "requires_medical_evaluation": true, "financial_management_needed": true, "no_existing_powers_of_attorney": true, "petitioner_relationship": "daughter"}, "narrative": "Thomas J. Ellison, a 72-year-old Cumberland County resident, has been diagnosed with progressive vascular dementia that significantly impairs his capacity to manage substantial financial assets, including a diversified retirement portfolio and a rental property in York County. His daughter, Eleanor Vance, files an initial petition seeking appointment as conservator to oversee bill payments, tax compliance, and asset preservation. Independent medical evaluations confirm limited financial decision-making capacity, and no durable power of attorney is currently in effect. The petition requests full financial conservatorship with no limitation on authority.", "party_lists": {}, "extra_parties": {}}, "event": {"case_id": "2024-CB-00916-CON", "type": "petition_filing_date", "date": "2024-03-15"}, "id": "conservatorship_ellison_initial_916", "description": "Synthesized conservatorship case", "scenario": "initial_petition"}
